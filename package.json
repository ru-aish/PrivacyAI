{
  "private": true,
  "name": "privacyai-monorepo",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "demo": "pnpm --filter @privacy-ai/web-demo dev",
    "test": "pnpm --filter @privacy-ai/sdk test",
    "test:sdk": "pnpm --filter @privacy-ai/sdk test",
    "test:extension": "pnpm --filter @privacy-ai/browser-extension test:e2e",
    "build": "pnpm --filter @privacy-ai/browser-extension build",
    "check": "pnpm run test:sdk && pnpm run build"
  },
  "dependencies": {
    "@privacy-ai/sdk": "workspace:*"
  }
}
