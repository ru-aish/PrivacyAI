{
  "name": "@privacy-ai/cli",
  "version": "0.4.0",
  "description": "Canonical PrivacyAI command for protected agents, onboarding, diagnostics, cache, and lineage inspection.",
  "type": "module",
  "main": "./src/cli.js",
  "exports": {
    ".": "./src/cli.js"
  },
  "bin": {
    "privacyai": "bin/privacyai.js"
  },
  "files": [
    "bin",
    "src",
    "vendor",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "release:check": "node ../../scripts/release/build.mjs --check",
    "pack:production": "node scripts/package-runtime.js pack",
    "prepack": "node scripts/package-runtime.js lifecycle",
    "postpack": "node scripts/package-runtime.js clean"
  },
  "dependencies": {
    "@privacy-ai/agent-bridge": "workspace:0.4.0",
    "@privacy-ai/sdk": "workspace:0.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ru-aish/PrivacyAI.git",
    "directory": "packages/agent-tui"
  },
  "homepage": "https://github.com/ru-aish/PrivacyAI#readme",
  "bugs": {
    "url": "https://github.com/ru-aish/PrivacyAI/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.18"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "license": "MIT"
}
