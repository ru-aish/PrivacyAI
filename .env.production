# Production Environment Variables for Privacy Guardian Gateway
# Copy this file to .env and configure the values

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=false
FLASK_PORT=5000
SECRET_KEY=your-secret-key-here-generate-a-secure-one

# Security Settings
REQUIRE_HTTPS=true
MAX_CONTENT_LENGTH=16777216  # 16MB
SESSION_TIMEOUT=3600  # 1 hour
RATE_LIMIT_PER_MINUTE=60

# AI Service Configuration
GEMINI_API_KEY=your-gemini-api-key-here
LM_STUDIO_BASE_URL=http://localhost:1234/v1
DEFAULT_AI_SERVICE=gemini

# Logging Configuration
LOG_LEVEL=INFO
SECURITY_LOG_FILE=security.log
APPLICATION_LOG_FILE=app.log

# CORS Settings (for production deployment)
CORS_ORIGINS=https://your-domain.com,https://your-app.com

# Database (if needed for session storage in future)
# DATABASE_URL=postgresql://user:password@localhost/privacyguardian

# Monitoring and Health Checks
HEALTH_CHECK_TOKEN=your-health-check-token
METRICS_ENABLED=true